#!/usr/bin/env python3
"""
HoopSync - NBA 2K Statistics Pipeline
Standalone executable that handles dependency checking and execution
"""

import sys
import subprocess
from pathlib import Path

def check_dependencies():
    """Check if required dependencies are installed"""
    required_packages = [
        ('cv2', 'opencv-python'),
        ('yaml', 'pyyaml'),
        ('pytesseract', 'pytesseract'),
        ('PIL', 'Pillow'),
        ('sqlalchemy', 'sqlalchemy'),
        ('flask', 'flask'),
    ]
    
    missing_packages = []
    
    for module_name, package_name in required_packages:
        try:
            __import__(module_name)
        except ImportError:
            missing_packages.append(package_name)
    
    return missing_packages

def install_dependencies(missing_packages):
    """Install missing dependencies"""
    if not missing_packages:
        return True
    
    print("🔧 Installing missing dependencies...")
    print(f"Missing packages: {', '.join(missing_packages)}")
    
    try:
        subprocess.check_call([
            sys.executable, '-m', 'pip', 'install'
        ] + missing_packages)
        print("✅ Dependencies installed successfully")
        return True
    except subprocess.CalledProcessError:
        print("❌ Failed to install dependencies")
        print("Please run manually: pip install -r requirements.txt")
        return False

def main():
    """Main entry point"""
    print("🏀 HoopSync - NBA 2K Statistics Pipeline")
    print("=" * 50)
    
    # Check dependencies
    missing = check_dependencies()
    
    if missing:
        print(f"⚠️  Missing dependencies: {', '.join(missing)}")
        print("")
        
        response = input("Install missing dependencies? (y/n): ").lower()
        if response == 'y':
            if not install_dependencies(missing):
                sys.exit(1)
        else:
            print("Please install dependencies manually:")
            print("pip install -r requirements.txt")
            sys.exit(1)
    
    # Change to script directory
    script_dir = Path(__file__).parent.absolute()
    import os
    os.chdir(script_dir)
    
    # Add to path
    if str(script_dir) not in sys.path:
        sys.path.insert(0, str(script_dir))
    
    # Run main application
    try:
        import main as hoopsync_main
        hoopsync_main.main()
    except Exception as e:
        print(f"❌ Error running HoopSync: {e}")
        import traceback
        traceback.print_exc()
        sys.exit(1)

if __name__ == "__main__":
    main()
